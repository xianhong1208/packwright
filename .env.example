# =============================================================================
# Packwright — environment configuration
#
# Nothing here is required: with no .env at all Packwright uses a local SQLite
# database, generates its secrets on first start (appending them here — keep
# this file chmod 600) and creates an admin account. See app/config.py for the
# full list of settings and README for the notable ones.
# =============================================================================

# --- Database (optional) ------------------------------------------------------
# Defaults to a local SQLite file (./data/build_center.db) — zero setup. To use
# PostgreSQL, set DATABASE_URL to its DSN and nothing else is needed:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/build_center
# DATABASE_URL=

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=5018
LOG_LEVEL=INFO

# --- Secrets (auto-generated when empty) --------------------------------------
JWT_SECRET_KEY=
SETTINGS_ENCRYPTION_KEY=

# --- Bootstrap admin ----------------------------------------------------------
# Created on first start when the database has no users, so you can log in right
# away. Leave BOOTSTRAP_ADMIN_PASSWORD unset to get a random password, printed once
# in the startup log; set it to choose one; set it empty to disable the account and
# use self-registration instead. Change the password after first login either way.
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# --- MCP Gate single sign-on (optional; off by default) -----------------------
# Enable to add a "Sign in with MCP Gate" button. Register Packwright as an
# OAuth client in MCP Gate, then fill these in. (MCP_CENTER_URL, the name from
# before MCP Gate's rename, is still read when MCP_GATE_URL is unset.)
# MCP_OAUTH_ENABLED=true
# MCP_GATE_URL=http://localhost:4568
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_REDIRECT_URI=http://localhost:5018/auth/oauth/mcp/callback

# --- Notable optional settings (defaults shown; uncomment to override) --------
# Git access tokens for private repos are managed in the console UI, not here.
# GITLAB_TOKEN=                       # legacy fallback, sent only to GITLAB_TOKEN_HOST
# GITLAB_TOKEN_HOST=gitlab.com         # exact host name of your GitLab server
# Storage paths default under ./data (relative to where you launch the app).
# Set absolute paths to move state onto another disk; see README "Storage & data".
# GIT_WORKSPACE_DIR=./data/workspace      # clones / build workspaces / downloadable outputs
# DOCKER_IMAGES_DIR=./data/docker_images  # exported Docker images (.tar.gz)
# NUITKA_CACHE_DIR=                   # Nuitka's cache incl. the ccache store (empty = ~/.cache/Nuitka)
# LOCAL_SOURCE_ROOTS=                 # CSV of dirs local-source builds may read (empty = off)
# MAX_CONCURRENT_BUILDS=3             # simultaneous builds; the rest queue
# PUBLIC_URL=https://packwright.example.com  # links in build notifications
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# TRUSTED_PROXY_IPS=                  # proxy IPs whose X-Forwarded-For to trust (empty = safest)
